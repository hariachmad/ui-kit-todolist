{
    "color": {
        "primary": {
            "$value": "#055a9b",
            "$type": "color",
            "description": "Warna brand utama, akan dipetakan ke --ion-color-primary"
        },
        "secondary": {
            "$value": "#85c145",
            "$type": "color",
            "description": "Warna brand kedua, akan dipetakan ke --ion-color-secondary"
        },
        "text": {
            "primary": {
                "$value": "#43493b",
                "$type": "color",
                "description": "Warna text primary"
            },
            "secondary": {
                "$value": "#5a6350",
                "$type": "color",
                "description": "Warna text secondary"
            },
            "badge": {
                "date": {
                    "$value": "#6A84AE",
                    "$type": "color",
                    "description": "Warna text yang ada di date badge"
                },
                "info": {
                    "$value": "#4C72A6",
                    "$type": "color",
                    "description": "Warna text yang ada di info badge"
                },
                "warning": {
                    "$value": "#A56E43",
                    "$type": "color",
                    "description": "Warna text yang ada di warning badge"
                },
                "alert": {
                    "$value": "#A22D48",
                    "$type": "color",
                    "description": "Warna text yang ada di alert badge"
                }
            }
        },
        "background": {
            "$value": "#ffffff",
            "$type": "color",
            "description": "Latar belakang halaman, akan dipetakan ke --ion-background-color"
        },
        "card": {
            "$value": "#eaf2f5",
            "$type": "color",
            "description": "Latar belakang card"
        },
        "badge": {
            "date": {
                "$value": "#C9E6F0",
                "$type": "color",
                "description": "Latar belakang badge date"
            },
            "info": {
                "$value": "#CCE2F0",
                "$type": "color",
                "description": "Latar belakang badge info"
            },
            "warning": {
                "$value": "#ECE1D3",
                "$type": "color",
                "description": "Latar belakang badge warning"
            },
            "alert": {
                "$value": "#E5D6DB",
                "$type": "color",
                "description": "Latar belakang badge alert"
            }
        },
        "input": {
            "$value": "#EBF2F5",
            "$type": "color",
            "description": "Latar belakang komponen input"
        }
    },
    "typography": {
        "fontFamily": {
            "base": {
                "$value": ["Inter", "-apple-system", "Roboto", "Helvetica Neue", "sans-serif"],
                "$type": "fontFamily",
                "description": "Font utama aplikasi, akan dipetakan ke --ion-font-family"
            },
            "mono": {
                "$value": ["JetBrains Mono", "Menlo", "Consolas", "monospace"],
                "$type": "fontFamily",
                "description": "Font monospace untuk kode atau angka tabular"
            }
        },
        "fontSize": {
            "xs": {
                "$value": "12px",
                "$type": "dimension",
                "description": "Caption, label kecil, teks badge"
            },
            "sm": {
                "$value": "14px",
                "$type": "dimension",
                "description": "Teks sekunder, helper text"
            },
            "md": {
                "$value": "16px",
                "$type": "dimension",
                "description": "Teks body default"
            },
            "lg": {
                "$value": "18px",
                "$type": "dimension",
                "description": "Subjudul, teks yang ditonjolkan"
            },
            "xl": {
                "$value": "20px",
                "$type": "dimension",
                "description": "Judul section"
            },
            "2xl": {
                "$value": "24px",
                "$type": "dimension",
                "description": "Judul halaman"
            },
            "3xl": {
                "$value": "30px",
                "$type": "dimension",
                "description": "Judul besar / hero"
            }
        },
        "fontWeight": {
            "regular": {
                "$value": 400,
                "$type": "fontWeight",
                "description": "Teks body"
            },
            "medium": {
                "$value": 500,
                "$type": "fontWeight",
                "description": "Label, teks yang ditekankan ringan"
            },
            "semibold": {
                "$value": 600,
                "$type": "fontWeight",
                "description": "Subjudul, tombol"
            },
            "bold": {
                "$value": 700,
                "$type": "fontWeight",
                "description": "Judul"
            }
        },
        "lineHeight": {
            "tight": {
                "$value": 1.25,
                "$type": "number",
                "description": "Untuk judul"
            },
            "normal": {
                "$value": 1.5,
                "$type": "number",
                "description": "Untuk teks body"
            },
            "relaxed": {
                "$value": 1.75,
                "$type": "number",
                "description": "Untuk teks panjang / paragraf"
            }
        },
        "letterSpacing": {
            "tight": {
                "$value": "-0.01em",
                "$type": "dimension",
                "description": "Untuk judul besar"
            },
            "normal": {
                "$value": "0em",
                "$type": "dimension",
                "description": "Default"
            },
            "wide": {
                "$value": "0.02em",
                "$type": "dimension",
                "description": "Untuk teks kecil uppercase atau badge"
            }
        }
    },
    "spacing": {
        "0": {
            "$value": "0px",
            "$type": "dimension",
            "description": "Tanpa jarak"
        },
        "1": {
            "$value": "4px",
            "$type": "dimension",
            "description": "Jarak sangat kecil"
        },
        "2": {
            "$value": "8px",
            "$type": "dimension",
            "description": "Jarak kecil"
        },
        "3": {
            "$value": "12px",
            "$type": "dimension",
            "description": "Jarak kecil-menengah"
        },
        "4": {
            "$value": "16px",
            "$type": "dimension",
            "description": "Jarak dasar antar elemen"
        },
        "5": {
            "$value": "20px",
            "$type": "dimension",
            "description": "Jarak menengah"
        },
        "6": {
            "$value": "24px",
            "$type": "dimension",
            "description": "Jarak antar grup elemen"
        },
        "8": {
            "$value": "32px",
            "$type": "dimension",
            "description": "Jarak besar"
        },
        "10": {
            "$value": "40px",
            "$type": "dimension",
            "description": "Jarak antar section"
        },
        "12": {
            "$value": "48px",
            "$type": "dimension",
            "description": "Jarak sangat besar"
        },
        "16": {
            "$value": "64px",
            "$type": "dimension",
            "description": "Jarak maksimum antar section besar"
        }
    },
    "radius": {
        "none": {
            "$value": "0px",
            "$type": "dimension",
            "description": "Tanpa lengkungan"
        },
        "sm": {
            "$value": "4px",
            "$type": "dimension",
            "description": "Badge kecil, checkbox"
        },
        "md": {
            "$value": "8px",
            "$type": "dimension",
            "description": "Input, tombol"
        },
        "lg": {
            "$value": "12px",
            "$type": "dimension",
            "description": "Card"
        },
        "xl": {
            "$value": "16px",
            "$type": "dimension",
            "description": "Modal, bottom sheet"
        },
        "full": {
            "$value": "9999px",
            "$type": "dimension",
            "description": "Pill badge, avatar, tombol bulat"
        }
    },
    "border": {
        "width": {
            "none": {
                "$value": "0px",
                "$type": "dimension",
                "description": "Tanpa border"
            },
            "thin": {
                "$value": "1px",
                "$type": "dimension",
                "description": "Border default"
            },
            "medium": {
                "$value": "2px",
                "$type": "dimension",
                "description": "Border fokus / aktif"
            },
            "thick": {
                "$value": "4px",
                "$type": "dimension",
                "description": "Aksen, indikator"
            }
        },
        "color": {
            "default": {
                "$value": "#d5dde0",
                "$type": "color",
                "description": "Warna border default"
            },
            "focus": {
                "$value": "{color.primary}",
                "$type": "color",
                "description": "Warna border saat fokus"
            }
        }
    },
    "shadow": {
        "sm": {
            "$value": {
                "color": "#0000001a",
                "offsetX": "0px",
                "offsetY": "1px",
                "blur": "2px",
                "spread": "0px"
            },
            "$type": "shadow",
            "description": "Elevasi rendah, untuk card"
        },
        "md": {
            "$value": {
                "color": "#0000001f",
                "offsetX": "0px",
                "offsetY": "4px",
                "blur": "8px",
                "spread": "-1px"
            },
            "$type": "shadow",
            "description": "Elevasi menengah, untuk dropdown"
        },
        "lg": {
            "$value": {
                "color": "#00000026",
                "offsetX": "0px",
                "offsetY": "12px",
                "blur": "24px",
                "spread": "-4px"
            },
            "$type": "shadow",
            "description": "Elevasi tinggi, untuk modal dan bottom sheet"
        }
    },
    "motion": {
        "duration": {
            "fast": {
                "$value": "100ms",
                "$type": "duration",
                "description": "Feedback instan (hover, press)"
            },
            "normal": {
                "$value": "200ms",
                "$type": "duration",
                "description": "Transisi standar"
            },
            "slow": {
                "$value": "350ms",
                "$type": "duration",
                "description": "Transisi besar (modal, page)"
            }
        },
        "easing": {
            "standard": {
                "$value": [0.2, 0, 0, 1],
                "$type": "cubicBezier",
                "description": "Easing standar untuk sebagian besar transisi"
            },
            "enter": {
                "$value": [0, 0, 0, 1],
                "$type": "cubicBezier",
                "description": "Elemen masuk ke layar"
            },
            "exit": {
                "$value": [0.3, 0, 1, 1],
                "$type": "cubicBezier",
                "description": "Elemen keluar dari layar"
            }
        }
    },
    "breakpoints": {
        "xs": {
            "$value": "0px",
            "$type": "dimension",
            "description": "Mobile portrait (default Ionic)"
        },
        "sm": {
            "$value": "576px",
            "$type": "dimension",
            "description": "Mobile landscape / phablet"
        },
        "md": {
            "$value": "768px",
            "$type": "dimension",
            "description": "Tablet portrait"
        },
        "lg": {
            "$value": "992px",
            "$type": "dimension",
            "description": "Tablet landscape / laptop kecil"
        },
        "xl": {
            "$value": "1200px",
            "$type": "dimension",
            "description": "Desktop"
        }
    },
    "z": {
        "base": {
            "$value": 0,
            "$type": "number",
            "description": "Layer default"
        },
        "dropdown": {
            "$value": 1000,
            "$type": "number",
            "description": "Dropdown, popover, select"
        },
        "sticky": {
            "$value": 1100,
            "$type": "number",
            "description": "Header / elemen sticky"
        },
        "overlay": {
            "$value": 1200,
            "$type": "number",
            "description": "Backdrop overlay"
        },
        "modal": {
            "$value": 1300,
            "$type": "number",
            "description": "Modal dan bottom sheet"
        },
        "toast": {
            "$value": 1400,
            "$type": "number",
            "description": "Toast dan notifikasi"
        },
        "tooltip": {
            "$value": 1500,
            "$type": "number",
            "description": "Tooltip, selalu paling atas"
        }
    },
    "padding": {
        "page": {
            "$value": "16px",
            "$type": "dimension",
            "description": "Padding horizontal konten halaman, dipetakan ke --ion-padding"
        },
        "card": {
            "$value": "16px",
            "$type": "dimension",
            "description": "Padding di dalam card"
        },
        "input": {
            "$value": "12px",
            "$type": "dimension",
            "description": "Padding di dalam komponen input"
        },
        "button": {
            "$value": "12px",
            "$type": "dimension",
            "description": "Padding vertikal tombol"
        },
        "badge": {
            "$value": "4px",
            "$type": "dimension",
            "description": "Padding vertikal badge"
        }
    }
}